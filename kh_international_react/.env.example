# KH International: enquiry endpoint configuration (names only, no values).
# Server-only variables are set in the hosting dashboard; NEVER give a secret the VITE_ prefix,
# because every VITE_* value is compiled into the public browser bundle.

# --- Server only -------------------------------------------------------------
# "resend" (default, production) or "mock" (local testing only; refused on Vercel)
ENQUIRY_TRANSPORT=
# Required together with ENQUIRY_TRANSPORT=mock or TURNSTILE_MODE=mock: local-testing-only
ENQUIRY_MOCK_ACKNOWLEDGE=
RESEND_API_KEY=
# Destination mailbox (must be verified by the owner before production)
ENQUIRY_TO=
# Sender address on a DKIM-verified (sub)domain
ENQUIRY_FROM=
ENQUIRY_FROM_NAME=
# "live" (default) or "mock" (local testing only; refused on Vercel)
TURNSTILE_MODE=
TURNSTILE_SECRET_KEY=
# Optional comma-separated extra allowed origins, e.g. https://www.example.com
ENQUIRY_ALLOWED_ORIGINS=
# Optional tuning (milliseconds)
ENQUIRY_PROVIDER_TIMEOUT_MS=
TURNSTILE_TIMEOUT_MS=
# Local mock outbox directory (default .enquiry-outbox)
ENQUIRY_OUTBOX_DIR=

# --- Public (compiled into the browser bundle) -------------------------------
# Turnstile site key; "mock" for local tests only
VITE_TURNSTILE_SITE_KEY=
# Shown on failures ONLY when set; leave empty until the contact details are verified
VITE_ENQUIRY_FALLBACK_EMAIL=
VITE_ENQUIRY_FALLBACK_PHONE=
